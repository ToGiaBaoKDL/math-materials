#item("4",[Cho tứ diện $O A B C$ có $O A ","   O B ","   O C$ đôi một vuông góc với nhau, $O A = a$ và $O B = O C = 2 a$. Gọi $M$ là trung điểm của $B C$. Khoảng cách giữa hai đường thẳng $O M$ và $A B$ bằng],source-id:"tu-luyen-4",answers:([$frac(sqrt(2) a, 2)$],[$a$],[$frac(2 sqrt(5) a, 5)$],[$frac(sqrt(6) a, 3)$],),answer-columns:4,solution:solutions.at("tu-luyen-4"))
#item("5",[Cho hình chóp $S . A B C$ có $A S ","   A B ","   A C$ đôi một vuông góc với nhau, $A B = a "," A C = a sqrt(2)$. Tính khoảng cách d từ đường thẳng $S A$ đến $B C$.],source-id:"tu-luyen-5",answers:([$d = frac(a sqrt(2), 2)$],[$d = a$],[$a sqrt(2)$],[$frac(a sqrt(6), 3)$],),answer-columns:4,solution:solutions.at("tu-luyen-5"))
#item("6",[Cho hình chóp $S . A B C D$ có đáy $A B C D$ là hình vuông cạnh $a$. Hình chiếu vuông góc của $S$ lên mặt phẳng $lr(( A B C D ))$ trùng với trung điểm $H$ của cạnh $A B$. Góc tạo bởi $S C$ và $lr(( A B C D ))$ bằng $45 °$. Tính theo $a$ khoảng cách giữa hai đường thẳng $S D$ và $A B$.],source-id:"tu-luyen-6",answers:([$d = frac(2 a sqrt(5), 3)$],[$d = frac(a sqrt(5), 13)$],[$d = frac(a sqrt(5), 3)$],[$d = frac(a sqrt(15), 3)$],),answer-columns:4,solution:solutions.at("tu-luyen-6"))
#item("7",[Cho hình chóp $S . A B C D$ có đáy $A B C D$ là hình vuông tâm $O$ , cạnh $a$. Cạnh bên $S A$ vuông góc với đáy, góc $∠ S B D = 60 °$. Tính theo $a$ khoảng cách giữa hai đường thẳng $A B$ và $S O$.],source-id:"tu-luyen-7",answers:([$frac(a sqrt(3), 3)$],[$frac(a sqrt(6), 4)$],[$frac(a sqrt(2), 2)$],[$frac(a sqrt(5), 5)$],),answer-columns:4,solution:solutions.at("tu-luyen-7"))
#item("8",[Cho hình chóp $S . A B C D$ có đáy hình vuông cạnh $a$. Gọi $M "," N$ lần lượt là trung điểm của $A B ","   A D$. $lr(\{ H \}) = D M ∩ C N$. Biết $S H$ vuông góc với $( A B C D )$, $S H = a sqrt(3)$. Tính $d ( D M "," S C )$.],source-id:"tu-luyen-8",answers:([$frac(2 sqrt(57), 19) a$],[$frac(2, 19) a$],[$frac(2 sqrt(57), 9) a$],[$frac(sqrt(57), 19) a$],),answer-columns:4,solution:solutions.at("tu-luyen-8"))
#item("9",[Cho lăng trụ đứng $A B C . A ' B ' C '$ có đáy $A B C$ là tam giác vuông tại $B$ với $A B = 4 a "," B C = 3 a "," A C = 5 a$, cạnh bên $B B ' = 9 a$. Gọi $M$ là điểm thuộc $B B '$ sao cho $B B ' = 3 B ' M$. Khoảng cách giữa $B ' C$ và $A M$ là],source-id:"tu-luyen-9",answers:([$frac(12 a, 7)$],[$frac(6 a, 7)$],[$frac(10 a, 7)$],[$frac(a, 7)$],),answer-columns:4,solution:solutions.at("tu-luyen-9"))

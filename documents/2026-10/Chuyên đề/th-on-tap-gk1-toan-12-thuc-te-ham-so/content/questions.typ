 set text(top-edge:1.1em,bottom-edge:0.65em)
 item(1,[#text(weight:"bold",fill:black)[(THPT ĐÔNG HÀ – QUẢNG TRỊ)] Một bể chứa ban đầu có 250 lít nước. Sau đó, cứ mỗi phút người ta bơm thêm 25 lít nước, đồng thời cho vào bể 8 gam chất khử khuẩn được hòa tan. Giả sử $C lr(( t ))$ là nồng độ chất khử khuẩn trong bể sau $t$ phút (với $C(t)=m(t) / V(t)$, đơn vị gam/lít, trong đó $m lr(( t ))$ là khối lượng chất khử khuẩn trong bể và $V lr(( t ))$ là thể tích nước trong bể). Gọi $c$ là số dương nhỏ nhất mà nồng độ chất khử khuẩn là $C lr(( t ))$ tăng theo thời gian $t$ nhưng không vượt quá ngưỡng $c$ gam/lít. Tìm $c$, làm tròn kết quả đến hàng phần trăm.],writing-lines:7)
 }
 item(2,[#text(weight:"bold",fill:black)[(THPT ĐÔNG HÀ – QUẢNG TRỊ)] Một vật chuyển động theo quy luật $S = 26 + 10 t ^(2) - frac(1, 3) t ^(3)$, với $t lr(( s ))$ là khoảng thời gian tính từ lúc vật bắt đầu chuyển động và $S lr(( m ))$ là quãng đường vật đi được trong khoảng thời gian đó. Hỏi trong khoảng thời gian $15$ giây từ lúc vật bắt đầu chuyển động vận tốc $v lr(( m / s ))$ của vật đạt giá trị lớn nhất tại thời điểm $t lr(( s ))$ bằng bao nhiêu?],writing-lines:7)
 item(3,[#text(weight:"bold",fill:black)[(THPT NGÔ SỸ LIÊN – BẮC NINH)] Khi bỏ qua sức cản của không khí, độ cao ( mét) của một vật thể sau thời gian t giây được phóng thẳng đứng lên trên từ điểm cách mặt đất $5$ mét với tốc độ ban đầu $"39,2"$ m/s là $h lr(( t )) = 5 + "39,2" t - "4,9" t ^(2)$, chọn chiều dương là chiều hướng từ dưới lên. ( theo Vật lí đại cương, NXB Giáo dục Việt Nam, 2016). Xét tính đúng sai của các mệnh đề sau:],writing-lines:8, statements:([a)  Vận tốc của vật lúc vật chạm đất là $- "40,43" ( m / s )$(kết quả làm tròn đến hàng phần trăm)],[b)  Vật đạt độ cao lớn nhất bằng $"83,4"$ mét tại thời điểm $t = 4$ giây.],[c)  Khoảng thời gian vật ở độ cao trên 10 mét dài hơn 7 giây.],[d)  Vận tốc của vật sau 3 giây là $"4,6" m / s$.],))
 item(4,[#text(weight:"bold",fill:black)[(THPT ĐINH TIÊN HOÀNG – NINH BÌNH)] Một doanh nghiệp dự định sản xuất không quá $400$ sản phẩm. Nếu doanh nghiệp sản xuất $x$ sản phẩm $lr(( 1 ≤ x ≤ 400 ))$ thì doanh thu nhận được khi bán hết số sản phẩm đó được biểu diễn bởi công thức là $F lr(( x )) = x ^(3) - 1999 x ^(2) + 1001000 x + 250000$(đồng). Trong đó chi phí vận hành máy móc cho mỗi sản phẩm là $G lr(( x )) = frac(100000 x, frac(3, 2) x + 1)$ (đồng). Tổng chi phí mua nguyên vật liệu được biểu diễn bởi hàm $H lr(( x )) = 2 x ^(3) + 100000 x - 50000$ (đồng) nhưng do doanh nghiệp đó mua nguyên vật liệu với số lượng lớn nên được giảm $1 %$ cho 200 sản phẩm đầu tiên doanh nghiệp sản xuất và giảm $2 %$ cho sản phẩm tiếp theo. Doanh nghiệp cần sản xuất bao nhiêu sản phẩm để lợi nhuận thu được là lớn nhất?],writing-lines:10)
 item(5,[#text(weight:"bold",fill:black)[(THPT NGÔ SỸ LIÊN – BẮC NINH)] Một nhà máy A chuyên sản xuất một loại sản phẩm cho nhà máy B, nhà máy A chỉ bán sản phẩm cho nhà máy B và nhà máy B cam kết thu mua hết số sản phẩm mà nhà máy A sản xuất được. Nhà máy A có khả năng sản xuất được tối đa là 200 tấn sản phẩm trong 1 tháng. Nếu bán ra $x$ tấn sản phẩm cho nhà máy B thì giá bán mỗi tấn sản phẩm là $50 - "0,0002" x ^(2)$ triệu đồng. Trong một tháng nhà máy A phải chi phí cho nhân công và chi cho khấu hao máy móc một lượng cố định là 150 triệu đồng, ngoài ra khi sản xuất mỗi tấn sản phẩm thì nhà máy phải chi phí thêm cho mua nguyên liệu là 35 triệu đồng. Biết rằng nhà máy A phải nộp $5 %$ doanh thu cho cơ quan thuế. Tính lợi nhuận sau thuế (lợi nhuận sau khi đã trừ tiền thuế) lớn nhất thu được trong 1 tháng của nhà máy A (đơn vị tính là tỉ đồng và kết quả làm tròn đến hàng phần trăm).],writing-lines:10)
 item(6,[#text(weight:"bold",fill:black)[(THPT YÊN LÃNG – HÀ NỘI)] Một con thuyền đang ở giữa sông tại vị trí $A$, cách bờ $4 "km"$ tại vị trí $C$ như hình vẽ. Người chèo  thuyền muốn đến điểm $B$ cách $C$ $10 "km"$ dọc theo bờ sông càng nhanh càng tốt. Người đó quyết định chèo thuyền vào một điểm $D$ nằm giữa hai điểm $B$ và $C$, sau đó chạy bộ từ $D$ đến $B$ Biết vận tốc chạy là $8 "km/h"$, vận tốc chèo thuyền là $5 "km/h"$. Biết tốc độ của dòng nước là không đáng kể so với tốc độ chèo thuyền của người đó. Hỏi thời gian ngắn nhất người đó có thể đi từ $A$ đến $B$ là bao nhiêu giờ? (Kết quả làm tròn đến hàng phần trăm). 
 #align(center,diagram("river"))],writing-lines:8)
 item(7,[#text(weight:"bold",fill:black)[(THPT VIỆT NAM BA LAN – HÀ NỘI)] Một bác nông dân có ba tấm lưới B40, mỗi tấm dài $a = 6 ( m )$ và muốn rào một mảnh vườn dọc theo bờ sông có dạng hình thang cân $A B C D$ như hình vẽ dưới đây. Biết rằng bờ sông là đường thẳng $C D$ không phải rào lưới, hỏi bác nông dân đó có thể rào được mảnh vườn có diện tích lớn nhất là bao nhiêu mét vuông? ( kết quả làm tròn đến hàng phần mười)
 #align(center,diagram("garden"))],writing-lines:8)
 item(8,[#text(weight:"bold",fill:black)[(THPT ĐINH YÊN DŨNG SỐ 2 – BẮC NINH)] Một tấm bạt hình vuông cạnh $30 m$ như hình vẽ dưới đây. Người ta dự tính cắt phần tô đậm của tấm bạt rồi gập và may lại (các đường may không đáng kể), nhằm mục đích phủ lên tháp đèn trang trí (tháp dạng hình chóp tứ giác đều) để tránh hư hại tháp khi trời mưa. Biết khối chóp hình thành sau khi gập và may lại cần thể tích lớn nhất thì mới phủ kín tháp đèn. Hỏi phần diện tích tấm bạt bị cắt là bao nhiêu để đảm bảo yêu cầu trên.
 #align(center,diagram("net"))],writing-lines:8)
 item(9,[#text(weight:"bold",fill:black)[(THPT NGÔ SỸ LIÊN – BẮC NINH)] Để thiết kế một chiếc bể cá hình hộp chữ nhật có chiều cao là $60 "cm"$, thể tích $96000 "cm" ^(3)$. Người thợ dùng loại kính để sử dụng làm mặt bên có giá thành $70000$ VNĐ/m2 và loại kính để làm mặt đáy có giá thành $100000$ VNĐ/m2. Tính chi phí thấp nhất để hoàn thành bể cá. (đơn vị nghìn đồng, làm tròn hàng phần mười)],writing-lines:7)
 item(10,[#text(weight:"bold",fill:black)[(THPT ĐÔNG HÀ – QUẢNG TRỊ)] Một tấm kẽm hình chữ nhật $A B C D$ có cạnh $A D=40 "cm", A B=60 "cm"$. Người ta gập tấm kẽm theo hai cạnh $E F$ và $G H$ cho đến khi $A D$ và $B C$ trùng nhau như hình vẽ bên để được một hình lăng trụ đứng khuyết hai đáy, biết $D F = H C$. Thể tích lớn nhất khối lăng trụ được tạo thành là $m sqrt(3)$($c m ^(3)$), giá trị $m$ bằng bao nhiêu?
 #align(center,diagram("prism"))],writing-lines:8)
 item(11,[#text(weight:"bold",fill:black)[(THPT ĐÔNG HÀ – QUẢNG TRỊ)] Cho một bờ hồ hình bán nguyệt có bán kính bằng $2 "km"$, đường kính $P R$ như hình vẽ sau : Anh Bình di chuyển từ $P$ đến $R$ theo hướng mũi tên với 2 công đoạn :  - Công đoạn 1: Từ điểm $P$ anh Bình chèo một chiếc thuyền điểm đến $Q$ trên bờ hồ (khác $P$, khác $R$)  với vận tốc $3 "km/h"$. - Công đoạn 2: Chạy bộ dọc theo thành hồ đến vị trí $R$ với vận tốc $6 "km/h"$.  Thời gian tối đa bao nhiêu phút thì anh Bình di chuyển từ $P$ đến $R$? 
 #align(center,diagram("lake"))],writing-lines:9)
 item(12,[#text(weight:"bold",fill:black)[(THPT THANH MIỆN – HẢI DƯƠNG)] Một phần đường chạy của tàu lượn siêu tốc  (hình 1) khi gắn hệ trục toạ độ $"O" x y$ được mô phỏng ở hình 2, đơn vị trên mỗi trục là mét. Biết đường chạy của nó là một phần đồ thị hàm bậc ba $y = a x ^(3) + b x ^(2) + c x + d lr(( 0 ≤ x < 90 ))$; tàu lượn siêu tốc xuất phát từ điểm $A$, đi qua các điểm $C "," D$ đồng thời đạt độ cao nhỏ nhất so với mặt đất là $6 m$. Độ cao lớn nhất mà tàu lượn siêu tốc đạt được là bao nhiêu mét so với mặt đất? (Kết quả làm tròn đến hàng phần chục).
 #align(center,diagram("coaster"))],writing-lines:9)
}